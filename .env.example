# Demo works immediately with no credentials. Use supabase only when configured.
NEXT_PUBLIC_DATA_MODE=demo

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Manual public profile lookups work by default. Emergency pause only:
DISABLE_PUBLIC_PROFILE_READING=false
# Background collection stays opt-in; the HTML adapter is unsupported by Google.
ENABLE_PUBLIC_HTML_INGESTION=false
